{
  "name": "@joethefkingfrypan/bk-mocha-suite",
  "version": "2.0.0",
  "description": "Suite for your mocha tests. Originally forked from https://github.com/muonjs/mocha-suit",
  "main": "app.js",
  "scripts": {
    "release": "bk-standard-version",
    "release:candidate": "npm version prepatch --preid=rc",
    "release:candidate:minor": "npm version preminor --preid=rc",
    "release:candidate:major": "npm version premajor --preid=rc",
    "release-major": "bk-standard-version -- --release-as major",
    "release-minor": "bk-standard-version -- --release-as minor",
    "test": "mocha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheOptimisticFactory/bk-mocha-suite.git"
  },
  "keywords": [
    "mocha",
    "tests",
    "suit",
    "jasmine"
  ],
  "author": "Romain Gagnaire <romain.gagnaire.pro@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TheOptimisticFactory/bk-mocha-suite/issues"
  },
  "homepage": "https://github.com/TheOptimisticFactory/bk-mocha-suite#readme",
  "dependencies": {
    "error-stack-parser": "2.1.4",
    "underscore": "1.13.7",
    "yn": ">=2.X, <5.X"
  },
  "types": "./mocha-suit.d.ts",
  "devDependencies": {
    "@joethefkingfrypan/bk-standard-version": "6.0.0",
    "@types/dirty-chai": "2.0.5",
    "chai-better-shallow-deep-equal": "1.1.1",
    "chai": ">=4.5.0 <5.X",
    "chalk": ">=4.1.2 <5.X",
    "dirty-chai": ">=2.0.1 <3.X",
    "config": "4.2.1",
    "expect.js": "0.3.1",
    "json-stringify-safe": "5.0.1",
    "mocha": "11.7.5",
    "sinon": "21.0.1",
    "should": "13.2.3"
  },
  "peerDependencies": {
    "@types/dirty-chai": ">=2.X",
    "chai-better-shallow-deep-equal": ">=1.X",
    "config": ">=3.X",
    "dirty-chai": ">=2.X",
    "json-stringify-safe": ">=5.X",
    "mocha": ">=3.X",
    "sinon": ">=7.X"
  }
}
